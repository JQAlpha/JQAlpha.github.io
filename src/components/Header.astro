---
interface Props {
  current: string;
}

const { current } = Astro.props;

const nav = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '文章' },
  { href: '/projects', label: '项目' },
  { href: '/about', label: '关于' },
];

const links = {
  github: 'https://github.com/JQAlpha',
  email: 'mailto:hi@jqalpha.com',
};
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur-md"
  style="border-color: var(--border); background: color-mix(in srgb, var(--bg) 82%, transparent);"
>
  <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2.5 font-medium">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg text-sm font-semibold text-white"
        style="background: linear-gradient(135deg, #2563eb, #7c3aed);">GQ</span
      >
      <span class="hidden sm:inline">Gary Wong</span>
    </a>

    <nav class="flex items-center gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm transition-colors',
              current === item.href
                ? 'font-medium'
                : 'hover:bg-[var(--bg-soft)]',
            ]}
            style={current === item.href ? 'color: var(--color-accent);' : 'color: var(--text-muted);'}
            aria-current={current === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <span class="mx-1 h-4 w-px" style="background: var(--border);"></span>
      <a
        href={links.github}
        class="rounded-lg px-2.5 py-1.5 text-sm transition-colors hover:bg-[var(--bg-soft)]"
        style="color: var(--text-muted);"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub">GitHub</a
      >
    </nav>
  </div>
</header>
